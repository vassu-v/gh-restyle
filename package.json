{
  "name": "gitling",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "web": "npm --workspace apps/app run web",
    "typecheck": "npm --workspace apps/app exec tsc -- --noEmit && tsc -p services/edge --noEmit && tsc -p apps/extension --noEmit",
    "lint": "npm --workspace apps/app run lint",
    "test": "vitest run",
    "test:live": "vitest run --config /dev/null packages/github/test/github.live.test.ts",
    "build:web": "npm --workspace apps/app exec expo -- export --platform web && node scripts/pwa.mjs",
    "build:extension": "node apps/extension/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:extension && npm run build:web",
    "e2e:signin": "node scripts/e2e-signin.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "e2e:studio": "node scripts/e2e-studio.mjs",
    "e2e:review": "node scripts/e2e-review.mjs",
    "e2e:onboarding": "node scripts/e2e-onboarding.mjs",
    "e2e:authenticator": "node scripts/e2e-authenticator.mjs",
    "stress:extension": "npm run build:extension && node scripts/stress-extension.mjs",
    "e2e:extension": "node scripts/e2e-extension.mjs",
    "test:fuzz": "vitest run tests/fuzz",
    "test:coverage": "vitest run --coverage",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "fast-check": "^3.23.2",
    "playwright": "^1.63.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
