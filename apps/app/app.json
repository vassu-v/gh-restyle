{
  "expo": {
    "name": "Gitling",
    "slug": "gitling",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gitling"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F11",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.gitling"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Gitling",
      "shortName": "Gitling",
      "themeColor": "#0E0F11",
      "backgroundColor": "#0E0F11",
      "display": "standalone"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false, "default": false } }],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "scheme": "gitling",
    "backgroundColor": "#0E0F11",
    "experiments": {
      "typedRoutes": true
    }
  }
}
